// Constraints para restador (Tang Nano 9K, GW1NR-LV9QN88PC6/I5)
// IMPORTANTE: verificar contra el pinout de SU placa que estos pines esten en bancos de 3.3 V.
//             Los pines de LEDs y botones de la placa estan en bancos de 1.8 V.

// ---------------- reloj 27 MHz ----------------
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------- reset: boton S1 (supuesto activo en bajo, con pull-up) ----------------
IO_LOC "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// ---------------- filas del teclado (entradas, pull-down EXTERNO en el teclado) ----------------
IO_LOC "rows[0]" 36;
IO_LOC "rows[1]" 37;
IO_LOC "rows[2]" 38;
IO_LOC "rows[3]" 39;
IO_PORT "rows[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rows[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rows[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "rows[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---------------- columnas del teclado (salidas) ----------------
IO_LOC "cols[0]" 40;
IO_LOC "cols[1]" 41;
IO_LOC "cols[2]" 42;
IO_LOC "cols[3]" 48;
IO_PORT "cols[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "cols[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "cols[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "cols[3]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------------- segmentos (a..g) = seg[6]..seg[0], activos en alto ----------------
IO_LOC "seg[6]" 25;   // a
IO_LOC "seg[5]" 26;   // b
IO_LOC "seg[4]" 27;   // c
IO_LOC "seg[3]" 28;   // d
IO_LOC "seg[2]" 29;   // e
IO_LOC "seg[1]" 30;   // f
IO_LOC "seg[0]" 31;   // g
IO_PORT "seg[6]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[0]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------------- enable de digitos (an[0] = digito derecho) ----------------
IO_LOC "an[0]" 32;
IO_LOC "an[1]" 33;
IO_LOC "an[2]" 34;
IO_LOC "an[3]" 35;
IO_PORT "an[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "an[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "an[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "an[3]" IO_TYPE=LVCMOS33 DRIVE=8;
